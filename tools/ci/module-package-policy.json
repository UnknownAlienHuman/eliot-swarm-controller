      "role": "host_launcher",
      "required_sibling_binaries": [
        "swarm-kernel-host"
      ]
    },
    {
      "package_name": "swarm-supervisor",
      "manifest": "crates/swarm-supervisor/Cargo.toml",
      "binary_target": "swarm-supervisor",
      "role": "host_supervisor",
      "required_sibling_binaries": []
    },
    {
      "package_name": "swarm-kernel-host",
      "manifest": "crates/swarm-kernel-host/Cargo.toml",
      "binary_target": "swarm-kernel-host",
      "role": "host_runtime",
      "required_sibling_binaries": [
        "swarm-supervisor"
      ],
      "resource_coordinate": "swarm-kernel-host-opencode-resources",
      "resource_installed_relative_root": "resources/modules/opencode",
      "resource_repository_relative_root": "modules/opencode",
      "resource_dependency_install": {
        "manager": "npm",
        "arguments": [
          "ci",
          "--ignore-scripts",
          "--no-audit",
          "--no-fund",
          "--no-progress",
          "--loglevel=error"
        ],
        "output_directory": "node_modules",
        "closure_manifest_file": "dependency-closure.json",
        "max_files": 100000,
        "max_entries": 200000,
        "max_total_bytes": 1073741824,
        "max_manifest_bytes": 33554432,
        "timeout_seconds": 1800
      },
      "resource_files": [
        {
          "path": "serve.mjs",
          "role": "server_program"
        },
        {
          "path": "native-mcp-proof.mjs",
          "role": "plugin_module"
        },
        {
          "path": "index.mjs",
          "role": "plugin_entry"
        },
        {
          "path": "package.json",
          "role": "dependency_manifest"
        },
        {
          "path": "package-lock.json",
          "role": "dependency_lock"
        }
      ],
      "additional_resource_groups": [
        {
          "coordinate": "swarm-kernel-host-antigravity-node-bridge",
          "module_id": "antigravity",
          "artifact_id": "antigravity-cli-warm-bridge.4",
          "version": "4",
          "repository_relative_root": "modules/antigravity",
          "installed_relative_root": "resources/modules/antigravity",
          "resource_files": [
            { "path": "bridge.mjs", "role": "retained_bridge_v3_entry" },
            { "path": "bridge-v4.mjs", "role": "bridge_v4_entry" },
            { "path": "codec.mjs", "role": "native_stream_codec" },
            { "path": "control.mjs", "role": "authenticated_host_control_client" },
            { "path": "module-descriptor.template.json", "role": "module_descriptor_template" },
            { "path": "package.json", "role": "node_package_manifest" },
            { "path": "receipt-state.mjs", "role": "local_receipt_state" }
          ]
        }
      ]
    }
  ]
