    },
    {
      "package_name": "swarm-bus",
      "manifest": "crates/swarm-bus/Cargo.toml",
      "binary_target": "swarm-bus-dispatcher"
    },
    {
      "package_name": "swarm-automation",
      "manifest": "crates/swarm-automation/Cargo.toml",
