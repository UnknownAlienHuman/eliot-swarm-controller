      "manifest": "crates/swarm-process/Cargo.toml",
      "binary_target": "swarm-module-owner"
    },
    {
      "package_name": "swarm-script-worker",
      "manifest": "crates/swarm-script-worker/Cargo.toml",
      "binary_target": "swarm-script-worker"
    },
    {
      "package_name": "swarm-observer",
      "manifest": "crates/swarm-observer/Cargo.toml",
      "binary_target": "swarm-observer"
