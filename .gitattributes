* text=auto
*.md text eol=lf
*.rs text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.py text eol=lf
*.mjs text eol=lf
Justfile text eol=lf
*.ps1 text eol=lf
